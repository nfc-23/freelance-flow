rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isDeveloper() {
      return isSignedIn() && (
        request.auth.token.email == 'mdomaerislam@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@developer\\.local$')) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/authorized_developers/$(request.auth.token.email)))
      );
    }

    function isOwner(data) {
      return isSignedIn() && (data.userId == request.auth.uid || isDeveloper());
    }

    function isOwnerFromResource() {
      return isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // Authorized Developers Whitelist & Access Management
    match /authorized_developers/{devEmail} {
      allow read: if isSignedIn();
      allow write: if isDeveloper();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isDeveloper());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isDeveloper());
      allow delete: if isDeveloper();
    }

    // Visitor Logs
    match /visitor_logs/{logId} {
      allow create: if true; // Track any visitor/portal hit
      allow read: if isDeveloper();
      allow delete: if isDeveloper();
    }

    // Clients
    match /clients/{clientId} {
      function isValidClient(data) {
        return (data.userId == request.auth.uid || isDeveloper()) &&
               data.name is string && data.name.size() > 0 && data.name.size() < 256 &&
               data.email is string && data.email.size() > 0;
      }
      
      allow get: if true; // Public access for portal/invoices
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && isValidClient(incoming());
      allow update: if isOwner(existing()) && isValidClient(incoming());
      allow delete: if isOwner(existing());
    }

    // Projects
    match /projects/{projectId} {
      function isValidProject(data) {
        return (data.userId == request.auth.uid || isDeveloper()) &&
               data.title is string && data.title.size() > 0;
      }

      allow get: if true; // Public portal access
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isOwner(existing()) && isValidProject(incoming());
      allow delete: if isOwner(existing());
    }

    // Tasks
    match /tasks/{taskId} {
      function isValidTask(data) {
        return (data.userId == request.auth.uid || isDeveloper()) &&
               data.projectId is string &&
               data.title is string && data.title.size() > 0;
      }

      allow get: if true; // Public portal access
      allow list: if (isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper())) || (resource.data.projectId != null);
      allow create: if isSignedIn() && isValidTask(incoming());
      allow update: if isOwner(existing()) && isValidTask(incoming());
      allow delete: if isOwner(existing());
    }

    // Invoices
    match /invoices/{invoiceId} {
      function isValidInvoice(data) {
        return (data.userId == request.auth.uid || isDeveloper()) &&
               data.invoiceNumber is string &&
               data.amount is number;
      }

      allow get: if true; // Public access
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && isValidInvoice(incoming());
      allow update: if isOwner(existing()) && isValidInvoice(incoming());
      allow delete: if isOwner(existing());
    }

    // Expenses
    match /expenses/{expenseId} {
      function isValidExpense(data) {
        return (data.userId == request.auth.uid || isDeveloper()) &&
               data.amount is number && data.amount > 0 &&
               data.description is string && data.description.size() > 0;
      }

      allow get: if isOwner(existing());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && isValidExpense(incoming());
      allow update: if isOwner(existing()) && isValidExpense(incoming());
      allow delete: if isOwner(existing());
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
      allow create: if true; // Allow unauthenticated portal clients to create notifications
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
    }

    // Project Comments
    match /project_comments/{commentId} {
      function isValidComment(data) {
        return data.projectId is string &&
               data.text is string && data.text.size() > 0 &&
               data.username is string;
      }

      // Portal access: allow read if we know the project exists? 
      // For now, let's allow read by ID or if filtering by projectId
      allow read: if (isSignedIn()) || (resource.data.projectId != null); 
      allow create: if isSignedIn() || (incoming().projectId != null); // Allow portal guests to comment too? Use isSignedIn() if you only want registered users.
      allow delete: if isSignedIn(); 
    }
  }
}
